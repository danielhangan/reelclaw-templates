{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "packages/*/src/**/*.mjs",
    "packages/*/bin/**/*.mjs",
    "cli/bin/**/*.mjs",
    "packages/*/test/**/*.mjs",
    "templates/*/*.mjs",
    "scripts/**/*.mjs",
    "test/**/*.mjs"
  ],
  "exclude": ["node_modules", "**/node_modules"]
}
