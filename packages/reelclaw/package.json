{
  "name": "reelclaw",
  "version": "0.1.0",
  "description": "Viral short-form video templates for Claude Code and Codex. npx reelclaw@latest add <template>, then edit and render 1080x1920 reels.",
  "type": "module",
  "bin": {
    "reelclaw": "bin/reelclaw.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./core": "./src/core/index.mjs",
    "./cli": "./src/cli/main.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "fonts"
  ],
  "scripts": {
    "prepack": "node -e \"require('node:fs').cpSync('../../shared/fonts','fonts',{recursive:true})\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "hyperframes": "0.8.181",
    "zod": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielhangan/reelclaw-templates.git",
    "directory": "packages/reelclaw"
  },
  "homepage": "https://github.com/danielhangan/reelclaw-templates#readme",
  "keywords": [
    "tiktok",
    "reels",
    "shorts",
    "video",
    "template",
    "hyperframes",
    "ugc",
    "claude-code",
    "codex"
  ],
  "license": "MIT"
}
